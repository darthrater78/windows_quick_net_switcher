<Window x:Class="QuickNetSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Net Switcher v1.3.1"
        Width="620" Height="580"
        MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Icon="Resources/app.ico"
        ResizeMode="CanResizeWithGrip"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One piece of an adapter's detail line. -->
        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <!-- Cells of the route grid and the firewall log: lines only, selected row
             in the hover tone. -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The funnel in a log column's header; accent-coloured while that column
             is filtered. -->
        <Style x:Key="HeaderFilterButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE71C;" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="RouteHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ContentRow" Height="3*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ActivityRow" Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Adapters / Route Table / Firewall, as one segmented control. Each tab's
             own filters sit directly under it, in the same place on every tab. -->
        <TabControl Grid.Row="0" x:Name="MainTabs"
                    Style="{StaticResource MainTabControlStyle}"
                    SelectionChanged="MainTabs_SelectionChanged">

            <!-- Adapters Tab -->
            <TabItem Header="Adapters" BorderThickness="0,0,1,0">
                <TabItem.Tag>
                    <CornerRadius>5,0,0,5</CornerRadius>
                </TabItem.Tag>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,10,0,10">
                        <CheckBox x:Name="HideDisconnectedCheckBox"
                                  Content="Hide disconnected"
                                  Margin="0,0,16,0"
                                  Click="HideDisconnected_Click" />
                        <CheckBox x:Name="ShowAllDetailsCheckBox"
                                  Content="Show all details"
                                  ToolTip="Open every adapter's details. Click a single adapter to open just that one."
                                  Click="ShowAllDetails_Click" />
                    </WrapPanel>

                    <ListBox Grid.Row="1" x:Name="AdapterList"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="AdapterList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="AdapterList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="AdapterList_PreviewMouseLeftButtonUp"
                             PreviewKeyDown="AdapterList_PreviewKeyDown"
                             DragOver="AdapterList_DragOver"
                             Drop="AdapterList_Drop"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <ContentPresenter />
                                                <Rectangle x:Name="focus"
                                                           RadiusX="6" RadiusY="6"
                                                           Stroke="{DynamicResource AccentBrush}"
                                                           StrokeThickness="2"
                                                           IsHitTestVisible="False"
                                                           Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="focus" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Clicking the row opens its details; the handle, the
                                     switch, the metric link and the DNS controls keep their own clicks. -->
                                <Grid x:Name="row"
                                      Background="Transparent"
                                      MinHeight="54"
                                      MouseLeftButtonUp="AdapterRow_MouseLeftButtonUp">
                                    <!-- A Rectangle, not a Border: a disabled adapter's
                                         row is dashed, and Border cannot dash. -->
                                    <Rectangle x:Name="frame"
                                               RadiusX="6" RadiusY="6"
                                               Fill="{DynamicResource CardBrush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1" />
                                    <Grid Margin="0,7,14,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Drag handle -->
                                        <Border Grid.Column="0"
                                                Width="26" Cursor="SizeAll"
                                                Background="Transparent"
                                                ToolTip="Drag to reorder"
                                                Tag="DragHandle">
                                            <Path Data="M0,0h2v2h-2z M5,0h2v2h-2z M0,5h2v2h-2z M5,5h2v2h-2z M0,10h2v2h-2z M5,10h2v2h-2z"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Name, and the status in words beside its dot -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="name"
                                                       Text="{Binding Name}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Width="8" Height="8"
                                                         Margin="0,0,6,0"
                                                         StrokeThickness="1.5"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <!-- Disabled: an empty ring. -->
                                                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Connected">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusConnectedBrush}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource StatusConnectedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Disconnected">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusDisconnectedBrush}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource StatusDisconnectedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Working">
                                                                    <Setter Property="StrokeDashArray" Value="1 1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding IpDisplay}"
                                                   FontSize="12"
                                                   FontFamily="{StaticResource DataFont}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,14,0" />

                                        <CheckBox Grid.Column="3"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Click="ToggleAdapter_Click"
                                                  Tag="{Binding AdapterId}" />

                                        <!-- Details: one adapter's when its row is clicked,
                                             every adapter's with "Show all details". -->
                                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Margin="0,7,0,0" Padding="0,5,0,0"
                                                Visibility="{Binding DetailsOpen, Converter={StaticResource BoolToVis}}">
                                            <WrapPanel>
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           Text="{Binding GatewayDisplay}"
                                                           Visibility="{Binding HasGateway, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource LinkButton}"
                                                        Content="{Binding MetricDisplay}"
                                                        ToolTip="Change the interface metric"
                                                        FontSize="12"
                                                        FontFamily="{StaticResource DataFont}"
                                                        Padding="0,4"
                                                        Margin="0,0,16,0"
                                                        Tag="{Binding}"
                                                        Click="EditMetric_Click"
                                                        Visibility="{Binding HasIp, Converter={StaticResource BoolToVis}}" />
                                                <CheckBox Content="Register in DNS"
                                                          ToolTip="Register this connection's addresses in DNS"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,16,0"
                                                          IsChecked="{Binding RegistersInDns, Mode=OneWay}"
                                                          Tag="{Binding}"
                                                          Click="ToggleDnsRegistration_Click"
                                                          Visibility="{Binding HasIp, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource LinkButton}"
                                                        Content="Register now"
                                                        ToolTip="Register this computer in DNS now and check the result. Windows registers every adapter that has the box ticked."
                                                        FontSize="12"
                                                        Padding="0,4"
                                                        Margin="0,0,16,0"
                                                        Tag="{Binding}"
                                                        Click="RegisterDnsNow_Click"
                                                        Visibility="{Binding CanRegisterNow, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           Text="{Binding Speed}"
                                                           Visibility="{Binding HasSpeed, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           Text="{Binding MacAddress}"
                                                           Visibility="{Binding HasMac, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           Text="{Binding DnsSuffix, StringFormat='dns {0}'}"
                                                           Visibility="{Binding HasDnsSuffix, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           Text="{Binding Description}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </WrapPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="frame" Property="Fill" Value="Transparent" />
                                        <Setter TargetName="frame" Property="StrokeDashArray" Value="4 3" />
                                        <Setter TargetName="name" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEnabled}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, ElementName=row}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="frame" Property="Fill" Value="{DynamicResource HoverBrush}" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Route Table Tab -->
            <TabItem Header="Route Table" BorderThickness="0,0,1,0">
                <TabItem.Tag>
                    <CornerRadius>0</CornerRadius>
                </TabItem.Tag>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,10,0,10">
                        <CheckBox x:Name="ShowDefaultRoutes" Content="Default" IsChecked="True"
                                  Margin="0,0,16,0" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed" />
                        <CheckBox x:Name="ShowRemoteRoutes" Content="Remote" IsChecked="True"
                                  Margin="0,0,16,0" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed" />
                        <CheckBox x:Name="ShowLocalRoutes" Content="Local" IsChecked="True"
                                  Margin="0,0,16,0" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed" />
                        <CheckBox x:Name="ShowOtherRoutes" Content="Link-Local / Loopback / Broadcast"
                                  IsChecked="False" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed" />
                    </WrapPanel>

                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="1">
                        <!-- Lines only: rows are separated by one rule, with no
                             alternating fill. -->
                        <DataGrid x:Name="RouteGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  FontSize="12"
                                  FontFamily="{StaticResource DataFont}"
                                  ColumnHeaderStyle="{StaticResource RouteHeader}"
                                  CellStyle="{StaticResource GridCell}">
                            <DataGrid.Columns>
                                <!-- Wide enough for the longest IPv4 prefix, 255.255.255.255/32. -->
                                <DataGridTextColumn Header="Destination" Binding="{Binding DisplayDestination}" Width="156" />
                                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="130" />
                                <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="*" FontFamily="{StaticResource UiFont}" />
                                <!-- Right-aligned so the digits line up. -->
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="64">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource RouteHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding RouteType}" Width="80" FontFamily="{StaticResource UiFont}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Firewall Tab -->
            <TabItem Header="Firewall">
                <TabItem.Tag>
                    <CornerRadius>0,5,5,0</CornerRadius>
                </TabItem.Tag>
                <Grid>
                    <!-- The profiles, with each one's logging settings in its details. -->
                    <Grid x:Name="FirewallMain">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <ItemsControl x:Name="FirewallList" Grid.Row="0" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="54" Margin="0,0,0,4">
                                    <Rectangle x:Name="frame"
                                               RadiusX="6" RadiusY="6"
                                               Fill="{DynamicResource CardBrush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1" />
                                    <Grid Margin="14,7,14,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="name"
                                                       Text="{Binding Name}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding InUseOn}"
                                                       ToolTip="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <!-- The state in words, so the switch is not the
                                             only thing saying it. -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,14,0" />
                                        <CheckBox Grid.Column="2"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Click="ToggleFirewall_Click"
                                                  Tag="{Binding ProfileKey}" />

                                        <!-- Logging. The boxes show what Windows has set; a
                                             Group Policy setting can't be changed here. -->
                                        <Border Grid.Row="1" Grid.ColumnSpan="3"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Margin="0,7,0,0" Padding="0,5,0,0">
                                            <WrapPanel>
                                                <CheckBox Content="Log dropped packets"
                                                          VerticalAlignment="Center"
                                                          Margin="0,4,16,4"
                                                          IsChecked="{Binding LogDropped, Mode=OneWay}"
                                                          IsEnabled="{Binding CanChangeLogging}"
                                                          Tag="{Binding}"
                                                          Click="LogDropped_Click" />
                                                <CheckBox Content="Log allowed connections"
                                                          VerticalAlignment="Center"
                                                          Margin="0,4,16,4"
                                                          IsChecked="{Binding LogAllowed, Mode=OneWay}"
                                                          IsEnabled="{Binding CanChangeLogging}"
                                                          Tag="{Binding}"
                                                          Click="LogAllowed_Click" />
                                                <Button Style="{StaticResource LinkButton}"
                                                        Content="View log"
                                                        FontSize="12"
                                                        Padding="0,4"
                                                        Margin="0,0,16,0"
                                                        Tag="{Binding}"
                                                        Click="ViewFirewallLog_Click"
                                                        Visibility="{Binding CanViewLog, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           Text="{Binding LogFileDisplay}"
                                                           Visibility="{Binding IsLogging, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           Text="Set by Group Policy"
                                                           Visibility="{Binding LoggingSetByPolicy, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           Text="Log file isn't on a local drive, so it isn't opened here"
                                                           Visibility="{Binding LogPathRefused, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource DetailText}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           Text="{Binding HitsText}"
                                                           Visibility="{Binding CanViewLog, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="frame" Property="Fill" Value="Transparent" />
                                        <Setter TargetName="frame" Property="StrokeDashArray" Value="4 3" />
                                        <Setter TargetName="name" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hits: the busiest sources in the last few minutes, dropped and
                         allowed, with the profile and interface each came in under. -->
                    <Border x:Name="HitsPanel" Grid.Row="1"
                            Margin="0,6,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="9,6,9,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                        Content="Open viewer" FontSize="12" Padding="0,2" Margin="12,0,0,0"
                                        Click="OpenViewerFromHits_Click" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                        Content="Clear" FontSize="12" Padding="0,2"
                                        ToolTip="Start counting again from now. The log file itself is not changed."
                                        Click="ClearHits_Click" />
                                <TextBlock x:Name="HitsTitle"
                                           Text="Top sources · last 5 minutes"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <TextBlock x:Name="HitsEmpty"
                                           Text="Turn on logging for a profile to see hits here."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="10,4"
                                           Visibility="Collapsed" />
                                <DataGrid x:Name="HitsGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          RowBackground="Transparent"
                                          SelectionMode="Extended"
                                          ClipboardCopyMode="ExcludeHeader"
                                          CanUserResizeRows="False"
                                          FontSize="12"
                                          FontFamily="{StaticResource DataFont}"
                                          ColumnHeaderStyle="{StaticResource RouteHeader}"
                                          CellStyle="{StaticResource GridCell}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Source" Width="*" SortMemberPath="Address">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource UiFont}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Dropped" Binding="{Binding Dropped}" Width="64" />
                                        <DataGridTextColumn Header="Allowed" Binding="{Binding Allowed}" Width="64" />
                                        <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="62" FontFamily="{StaticResource UiFont}" />
                                        <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="80" FontFamily="{StaticResource UiFont}" />
                                        <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </Border>
                    </Grid>

                    <!-- The log viewer, in place of the profiles while it is open. -->
                    <Grid x:Name="FirewallLogView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,10,0,10" LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource LinkButton}"
                                    Content="← Profiles"
                                    FontSize="12"
                                    Padding="0,4"
                                    Margin="0,0,16,0"
                                    Click="CloseFirewallLog_Click" />
                            <CheckBox x:Name="FwShowDropped" DockPanel.Dock="Left" Content="Dropped" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                      Checked="FirewallLogFilter_Changed" Unchecked="FirewallLogFilter_Changed" />
                            <CheckBox x:Name="FwShowAllowed" DockPanel.Dock="Left" Content="Allowed" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                      Checked="FirewallLogFilter_Changed" Unchecked="FirewallLogFilter_Changed" />
                            <CheckBox x:Name="FwResolveNames" DockPanel.Dock="Left" Content="Resolve names"
                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                      ToolTip="Also look up names for outside addresses. Local addresses are always looked up. A lookup can tell an address's owner that it was noticed."
                                      Click="ResolveNames_Click" />
                            <CheckBox x:Name="FwFollow" DockPanel.Dock="Left" Content="Follow new lines" IsChecked="True"
                                      VerticalAlignment="Center"
                                      ToolTip="Add new lines as Windows writes them. Windows writes the log in batches, so a line can arrive a few seconds late."
                                      Checked="FirewallFollow_Changed" Unchecked="FirewallFollow_Changed" />
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource LinkButton}"
                                    Content="Copy all"
                                    ToolTip="Copy every line shown, in the order shown. Ctrl+C copies only the selected lines."
                                    FontSize="12"
                                    Padding="0,4"
                                    Margin="10,0,0,0"
                                    Click="CopyFirewallLog_Click" />
                            <TextBox x:Name="FwFilterBox" DockPanel.Dock="Right"
                                     Width="130" FontSize="12" Padding="8,3"
                                     FontFamily="{StaticResource DataFont}"
                                     MaxLength="64"
                                     ToolTip="Show only lines whose source or destination contains this"
                                     AutomationProperties.Name="Filter by IP or port"
                                     TextChanged="FirewallLogFilter_Changed" />
                        </DockPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="1">
                            <!-- Newest first, so new lines arrive at the top, until a header is clicked to sort. -->
                            <DataGrid x:Name="FirewallLogGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      SelectionMode="Extended"
                                      ClipboardCopyMode="ExcludeHeader"
                                      CanUserResizeRows="False"
                                                                            FontSize="12"
                                      FontFamily="{StaticResource DataFont}"
                                      ColumnHeaderStyle="{StaticResource RouteHeader}"
                                      CellStyle="{StaticResource GridCell}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="64" SortMemberPath="When" />
                                    <DataGridTextColumn Binding="{Binding Action}" Width="78" FontFamily="{StaticResource UiFont}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Action" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource HeaderFilterButton}" Tag="Action" Click="HeaderFilter_Click"
                                                        ToolTip="Filter by action" AutomationProperties.Name="Filter by action" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Protocol}" Width="62">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Proto" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource HeaderFilterButton}" Tag="Protocol" Click="HeaderFilter_Click"
                                                        ToolTip="Filter by proto" AutomationProperties.Name="Filter by proto" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Source" Width="*" SortMemberPath="SourceIp">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SourceName}" FontFamily="{StaticResource UiFont}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Destination" Width="*" SortMemberPath="DestIp">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DestName}" FontFamily="{StaticResource UiFont}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding Interface}" Width="86" FontFamily="{StaticResource UiFont}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Interface" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource HeaderFilterButton}" Tag="Interface" Click="HeaderFilter_Click"
                                                        ToolTip="Filter by interface" AutomationProperties.Name="Filter by interface" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Profile}" Width="70" FontFamily="{StaticResource UiFont}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Profile" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource HeaderFilterButton}" Tag="Profile" Click="HeaderFilter_Click"
                                                        ToolTip="Filter by profile" AutomationProperties.Name="Filter by profile" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer: what just happened on the left, and on the right the two links
             every view keeps, then Refresh and Settings. -->
        <!-- Activity log: what the app did, line by line. Opened from the footer's
             Log link, or by an action that writes to it. -->
        <!-- Drag to share the height between the list and the activity log. Star
             rows, so the split keeps its proportion when the window is resized. -->
        <GridSplitter x:Name="ActivitySplitter" Grid.Row="1"
                      Visibility="Collapsed"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Cursor="SizeNS"
                      ToolTip="Drag to resize the activity log"
                      AutomationProperties.Name="Resize the activity log">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Rectangle Width="36" Height="3" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource ControlBorderBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Border x:Name="ActivityPane" Grid.Row="2"
                Visibility="Collapsed"
                MinHeight="70"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,7">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                            Content="Close" FontSize="12" Padding="0,2" Margin="12,0,0,0"
                            Click="CloseActivityLog_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                            Content="Clear" FontSize="12" Padding="0,2" Margin="12,0,0,0"
                            Click="ClearActivityLog_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                            Content="Copy" FontSize="12" Padding="0,2"
                            Click="CopyActivityLog_Click" />
                    <TextBlock Text="Activity log" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <!-- Read-only rich text rather than a list, so any part of the log can be
                     highlighted and copied, while error lines keep their colour. -->
                <RichTextBox x:Name="ActivityText"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             FontFamily="{StaticResource DataFont}"
                             FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentFillBrush}"
                             FocusVisualStyle="{x:Null}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Activity log">
                    <FlowDocument PagePadding="0" />
                </RichTextBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <!-- Set-once preferences live behind the gear; the filters that change
                 what you are looking at stay under the tabs. -->
            <Button x:Name="SettingsButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    Content="&#xE713;"
                    ToolTip="Settings"
                    Click="SettingsButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="SettingsMenu">
                        <MenuItem x:Name="MinimizeToTrayMenuItem"
                                  Header="Minimize to tray"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="SettingMenuItem_Click" />
                        <MenuItem x:Name="PinToDesktopMenuItem"
                                  Header="Pin to desktop"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="PinToDesktop_Click" />
                        <MenuItem x:Name="DarkModeMenuItem"
                                  Header="Dark theme"
                                  IsCheckable="True"
                                  Click="DarkMode_Click" />
                        <Separator />
                        <MenuItem Header="Accent" IsEnabled="False" />
                        <!-- Tag is the name ThemeService knows the accent by. -->
                        <MenuItem x:Name="AccentTealMenuItem" Header="Teal" Tag="Teal"
                                  IsCheckable="True" Click="Accent_Click" />
                        <MenuItem x:Name="AccentWindowsMenuItem" Header="Match Windows" Tag="Windows"
                                  IsCheckable="True" Click="Accent_Click" />
                        <MenuItem x:Name="AccentGreenMenuItem" Header="Green" Tag="Green"
                                  IsCheckable="True" Click="Accent_Click" />
                        <MenuItem x:Name="AccentInkMenuItem" Header="None" Tag="Ink"
                                  IsCheckable="True" Click="Accent_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    Content="&#xE72C;"
                    ToolTip="Refresh. The list also refreshes itself when Windows reports a network change, and every 10 seconds while this tab is open."
                    Margin="0,0,2,0"
                    Click="RefreshButton_Click" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource LinkButton}"
                    Content="Release notes"
                    FontSize="12"
                    Padding="0,4"
                    Margin="0,0,10,0"
                    Click="ReleaseNotesLink_Click" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource LinkButton}"
                    Content="GitHub"
                    FontSize="12"
                    Padding="0,4"
                    Margin="12,0,12,0"
                    Click="GitHubLink_Click" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource LinkButton}"
                    Content="Log"
                    ToolTip="Show or hide the activity log"
                    FontSize="12"
                    Padding="0,4"
                    Margin="12,0,0,0"
                    Click="ToggleActivityLog_Click" />
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
