<Window x:Class="QuickNetSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Net Switcher v1.0.0"
        Width="420" Height="520"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/app.ico"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Quick Net Switcher"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Toggle network adapters on or off"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" />
            </Border.Effect>
            <DockPanel>
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        DockPanel.Dock="Right"
                        Click="RefreshButton_Click"
                        Padding="16,6"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
                <CheckBox x:Name="MinimizeToTrayCheckBox"
                          Content="Minimize to tray"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12" />
            </DockPanel>
        </Border>

        <!-- Adapter list -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                CornerRadius="8"
                Padding="4">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AdapterList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="AdapterItem_Click">
                                <DockPanel>
                                    <!-- Toggle switch on the right -->
                                    <CheckBox DockPanel.Dock="Right"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="ToggleAdapter_Click"
                                              Tag="{Binding AdapterId}" />

                                    <!-- Adapter info on the left -->
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Connected">
                                                                <Setter Property="Fill" Value="{StaticResource EnabledBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disconnected">
                                                                <Setter Property="Fill" Value="#FFA500" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Fill" Value="{StaticResource DisabledBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                        <Setter Property="Fill" Value="#999999" />
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="16,3,0,0">
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}  ·  {1}">
                                                        <Binding Path="Status" />
                                                        <Binding Path="NetworkAdapterType" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Speed, StringFormat='  ·  {0}'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Visibility="{Binding HasSpeed, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="8,4">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Left" />
        </Border>
    </Grid>
</Window>
