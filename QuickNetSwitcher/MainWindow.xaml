<Window x:Class="QuickNetSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Net Switcher v1.3.0"
        Width="620" Height="580"
        MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Icon="Resources/app.ico"
        ResizeMode="CanResizeWithGrip"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Quick Net Switcher"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Toggle network adapters on or off"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" />
            </Border.Effect>
            <DockPanel>
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        DockPanel.Dock="Right"
                        Click="RefreshButton_Click"
                        Padding="16,6"
                        Background="{DynamicResource AccentFillBrush}"
                        Foreground="{DynamicResource OnAccentBrush}"
                        BorderThickness="0"
                        Cursor="Hand" />
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox x:Name="MinimizeToTrayCheckBox"
                              Content="Minimize to tray"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="12"
                              Margin="0,2,16,2"
                              Click="SettingCheckBox_Click" />
                    <CheckBox x:Name="PinToDesktopCheckBox"
                              Content="Pin to desktop"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="12"
                              Margin="0,2,16,2"
                              Click="PinToDesktop_Click" />
                    <CheckBox x:Name="DarkModeCheckBox"
                              Content="Dark"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="12"
                              Margin="0,2,16,2"
                              Click="DarkMode_Click" />
                    <CheckBox x:Name="SimpleViewCheckBox"
                              Content="Simple view"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="12"
                              Margin="0,2,0,2"
                              Click="SimpleView_Click" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Tab control: Adapters / Route Table -->
        <TabControl Grid.Row="2" x:Name="MainTabs"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <!-- Adapters Tab -->
            <TabItem Header="Adapters">
                <Border Background="{DynamicResource CardBrush}"
                        CornerRadius="0,0,8,8"
                        Padding="4">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" />
                    </Border.Effect>
                    <ListBox x:Name="AdapterList"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="AdapterList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="AdapterList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="AdapterList_PreviewMouseLeftButtonUp"
                             DragOver="AdapterList_DragOver"
                             Drop="AdapterList_Drop"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,0,12,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <!-- Toggle switch on the right -->
                                        <CheckBox DockPanel.Dock="Right"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Click="ToggleAdapter_Click"
                                                  Tag="{Binding AdapterId}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
                                                    <!-- Detail view: align with the name row, which sits above three
                                                         further rows. Simple view: that row is the whole item. -->
                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                    <Setter Property="Margin" Value="0,14,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SimpleView}" Value="True">
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>

                                        <!-- Drag handle -->
                                        <Border DockPanel.Dock="Left"
                                                Width="24" Cursor="SizeAll"
                                                Background="Transparent"
                                                Tag="DragHandle">
                                            <TextBlock Text="⠿" FontSize="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.5" />
                                        </Border>

                                        <!-- Adapter info -->
                                        <StackPanel VerticalAlignment="Center" Margin="4,10,12,10">
                                            <!-- Row 1: status dot + name -->
                                            <DockPanel>
                                                <Ellipse Width="8" Height="8"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Connected">
                                                                    <Setter Property="Fill" Value="{DynamicResource EnabledBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Disconnected">
                                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                    <Setter Property="Fill" Value="{DynamicResource DisabledBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                            <Setter Property="Fill" Value="{DynamicResource UnknownBrush}" />
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <!-- Row 2: status + description -->
                                            <StackPanel Orientation="Horizontal" Margin="16,3,0,0"
                                                        Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}  ·  {1}">
                                                            <Binding Path="Status" />
                                                            <Binding Path="Description" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Speed, StringFormat='  ·  {0}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasSpeed, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding MacAddress, StringFormat='  ·  {0}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasMac, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <!-- Row 3: IP / CIDR / Gateway / Metric -->
                                            <StackPanel Orientation="Horizontal" Margin="16,2,0,0"
                                                        Visibility="{Binding ShowIpRow, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding IpDisplay}"
                                                           FontSize="12" FontFamily="Consolas"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding GatewayDisplay, StringFormat='   {0}'}"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasGateway, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding MetricDisplay, StringFormat='   {0}'}"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasMetric, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="edit" FontSize="10" Padding="4,0"
                                                        Margin="6,0,0,0" Cursor="Hand"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Tag="{Binding}"
                                                        Click="EditMetric_Click"
                                                        VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Row 4: DNS suffix -->
                                            <TextBlock Margin="16,2,0,0"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DnsSuffix, StringFormat='dns: {0}'}"
                                                       Visibility="{Binding ShowDnsRow, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>

            <!-- Route Table Tab -->
            <TabItem Header="Route Table">
                <Border Background="{DynamicResource CardBrush}"
                        CornerRadius="0,0,8,8"
                        Padding="4">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Route filter bar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
                            <CheckBox x:Name="ShowDefaultRoutes" Content="Default" IsChecked="True"
                                      Margin="0,0,12,0" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed"
                                      FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <CheckBox x:Name="ShowRemoteRoutes" Content="Remote" IsChecked="True"
                                      Margin="0,0,12,0" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed"
                                      FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <CheckBox x:Name="ShowLocalRoutes" Content="Local" IsChecked="True"
                                      Margin="0,0,12,0" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed"
                                      FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <CheckBox x:Name="ShowOtherRoutes" Content="Link-Local / Loopback / Broadcast"
                                      IsChecked="False" Checked="RouteFilter_Changed" Unchecked="RouteFilter_Changed"
                                      FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" x:Name="RouteGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource AltRowBrush}"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  FontSize="12"
                                  FontFamily="Consolas">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Destination" Binding="{Binding DisplayDestination}" Width="140" />
                                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="130" />
                                <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="120" />
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="60" />
                                <DataGridTextColumn Header="Type" Binding="{Binding RouteType}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Firewall Tab -->
            <TabItem Header="Firewall">
                <Border Background="{DynamicResource CardBrush}"
                        CornerRadius="0,0,8,8"
                        Padding="12">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Windows Firewall"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />
                        <ItemsControl x:Name="FirewallList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="ToggleFirewall_Click"
                                                      Tag="{Binding ProfileKey}" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <DockPanel>
                                                    <Ellipse Width="8" Height="8"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource DisabledBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource EnabledBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="14" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}  ·  {1}">
                                                                <Binding Path="Name" />
                                                                <Binding Path="Status" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="16,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border x:Name="StatusBar"
                Grid.Row="3"
                Margin="0,8,0,0"
                Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="GitHub"
                            Click="GitHubLink_Click"
                            FontSize="11"
                            Padding="0"
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}" />
                    <Button Content="Release Notes"
                            Click="ReleaseNotesLink_Click"
                            FontSize="11"
                            Padding="0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
