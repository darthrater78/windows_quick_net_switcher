<!--
  Dark palette. Mirrors every key in Light.xaml; see the comments there for what
  each token is for. Contrast figures for both themes are recorded in DESIGN.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SurfaceBrush" Color="#16191C" />
    <SolidColorBrush x:Key="CardBrush" Color="#23282D" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2A3036" />

    <SolidColorBrush x:Key="BorderBrush" Color="#3D464F" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#8B96A1" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3ADB7" />

    <SolidColorBrush x:Key="StatusConnectedBrush" Color="#6FD08A" />
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#E5B454" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" />

    <!-- White here, black in light: each moves a filled button away from its label
         colour, and shows on an unfilled one against this theme's surface. -->
    <SolidColorBrush x:Key="WashBrush" Color="#FFFFFF" />

    <Color x:Key="AccentTealColor">#5CC8D0</Color>
    <Color x:Key="AccentGreenColor">#6FD08A</Color>
    <Color x:Key="AccentInkColor">#F2F4F6</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#101418" />
</ResourceDictionary>
