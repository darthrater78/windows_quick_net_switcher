<!--
  Light palette. Dark.xaml defines the same key set; ThemeService swaps one for
  the other at runtime, so every key here must exist there too or a DynamicResource
  lookup will silently fall back to nothing. DESIGN.md is the record of what each
  token is for and the contrast it was checked at.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces. Card is an enabled row, a pane, a menu or an input; Hover is the
         same surface under the pointer. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#ECEEF1" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F4F5F7" />

    <!-- Lines. BorderBrush is decorative (row edges, dividers). ControlBorderBrush
         is what tells you a control is there, so it holds 3:1 against both surfaces. -->
    <SolidColorBrush x:Key="BorderBrush" Color="#C4CAD1" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#74808B" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#101418" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#535D68" />

    <!-- Status. Used for the dot beside the status word and for error text only. -->
    <SolidColorBrush x:Key="StatusConnectedBrush" Color="#1B6E30" />
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#A8261C" />

    <!-- Laid over a filled button at low opacity for hover and pressed, so the
         label keeps its contrast instead of fading with the whole button. -->
    <SolidColorBrush x:Key="WashBrush" Color="#000000" />

    <!-- Accent choices. ThemeService reads the one the user picked and writes the
         three Accent brushes below over these defaults; "Windows" is read from the
         system instead and has no entry here. -->
    <Color x:Key="AccentTealColor">#006D77</Color>
    <Color x:Key="AccentGreenColor">#1B6E30</Color>
    <Color x:Key="AccentInkColor">#101418</Color>

    <!-- AccentBrush is for text, links and the focus ring; AccentFillBrush is for
         filled states and is paired with OnAccentBrush. They are the same colour
         unless a Windows accent is too pale to read as text. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
</ResourceDictionary>
